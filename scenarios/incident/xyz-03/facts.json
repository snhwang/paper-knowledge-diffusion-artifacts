{
  "incident": "xyz-03",
  "notes": "Insider export of customer business contacts. The sensitive material is the employment matter, the three customers with contractual notice rights, and the identifiers of the employee, hosts, tickets and file.",
  "facts": [
    {"id": "X03-F01", "document": "01-alert", "classification": ["timeline", "internal-identifier"],
     "text": "DLP alert XYZ-2201 fired Thursday 17:42 from dlp-01 under rule DLP-77.",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["XYZ-2201", "DLP-77", "dlp-01"]}},
    {"id": "X03-F02", "document": "01-alert", "classification": ["timeline", "internal-identifier"],
     "text": "The sender was employee id E-4471; the attachment was customers_contacts_export.csv, 2.3 MB.",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["E-4471", "customers_contacts_export", "2.3 MB"]}},
    {"id": "X03-F03", "document": "01-alert", "classification": ["timeline", "internal-identifier"],
     "text": "DLP-77 alerts rather than blocks for attachments under 5 MB, so the message was delivered.",
     "deliver": ["commander", "security-lead"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["5 MB", "alert, not block", "not block"]}},
    {"id": "X03-F04", "document": "01-alert", "classification": ["timeline", "internal-identifier"],
     "text": "Mailbox access was suspended 09:15 Friday and the SSO account disabled 09:20 (XYZ-2203).",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["XYZ-2203", "09:20", "SSO"]}},

    {"id": "X03-F05", "document": "02-security-analysis", "classification": ["exploit-detail", "internal-identifier"],
     "text": "The export was made through the admin console's Export contacts function on admin-web-01 at 17:31, which wrote no audit record.",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["admin-web-01", "17:31", "/admin/contacts/export"]}},
    {"id": "X03-F06", "document": "02-security-analysis", "classification": ["exploit-detail", "internal-identifier"],
     "text": "The file holds 1,880 records for 212 clinics: staff names, work emails, work phones and account tier; no patient data, no credentials.",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["comms", "support"],
     "check": {"any_of": ["1,880", "1880", "account tier"]}},
    {"id": "X03-F07", "document": "02-security-analysis", "classification": ["exploit-detail", "internal-identifier"],
     "text": "Indicators: export calls outside the CRM sync window (02:00 to 02:30); any login attempt by E-4471 after Friday 09:20.",
     "deliver": ["commander", "security-lead"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["sync window", "02:00 to 02:30", "login attempt"]}},
    {"id": "X03-F08", "document": "02-security-analysis", "classification": ["exploit-detail", "internal-identifier"],
     "text": "No other exports by this user in the 90-day retention window; workstation ws-0412 was re-imaged Friday 15:00.",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["ws-0412", "90-day", "re-imaged"]}},

    {"id": "X03-F09", "document": "03-engineering-postmortem", "classification": ["remediation", "internal-identifier", "timeline"],
     "text": "Audit logging for the export function was deployed Friday 13:30 (XYZ-2204).",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["XYZ-2204", "13:30"]}},
    {"id": "X03-F10", "document": "03-engineering-postmortem", "classification": ["remediation", "internal-identifier", "timeline"],
     "text": "Exports now require a second approver (XYZ-2205), and DLP-77 was changed from alert to block (XYZ-2206).",
     "deliver": ["commander", "security-lead", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["XYZ-2205", "XYZ-2206", "alert to block"]}},
    {"id": "X03-F11", "document": "03-engineering-postmortem", "classification": ["remediation", "internal-identifier", "timeline"],
     "text": "The approval step blocks the nightly CRM sync; a service-account exemption (XYZ-2207) is needed before Monday 02:00.",
     "deliver": ["commander", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["XYZ-2207", "service account", "service-account"]}},
    {"id": "X03-F12", "document": "03-engineering-postmortem", "classification": ["remediation", "internal-identifier", "timeline"],
     "text": "Exports over 500 rows are watermarked with the requesting user id.",
     "deliver": ["commander", "oncall-engineer", "security-lead"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["watermark", "500 rows"]}},
    {"id": "X03-F13", "document": "03-engineering-postmortem", "classification": ["remediation", "internal-identifier", "timeline"],
     "text": "Access is to be removed automatically on an employee's confirmed last day (XYZ-2209).",
     "deliver": ["commander", "oncall-engineer"], "deny": ["legal", "comms", "support"],
     "check": {"any_of": ["XYZ-2209", "last day"]}},

    {"id": "X03-F14", "document": "04-legal-memo", "classification": ["privileged", "exposure"],
     "text": "Regulator notification is not required in either district; the low-risk decision must be documented under § 47(2).",
     "deliver": ["commander", "legal"], "deny": ["oncall-engineer", "comms", "support"],
     "check": {"any_of": ["47(2)", "not required in either district", "must be documented"]}},
    {"id": "X03-F15", "document": "04-legal-memo", "classification": ["privileged", "exposure"],
     "text": "Harbor Clinic Group, Westfield Family Practice and Lakeside Paediatrics have contractual notice rights (clause 9.1) within 7 days of discovery, due next Friday 08:50.",
     "deliver": ["commander", "legal"], "deny": ["oncall-engineer", "comms", "support"],
     "check": {"any_of": ["Harbor Clinic", "Westfield", "Lakeside", "clause 9.1"]}},
    {"id": "X03-F16", "document": "04-legal-memo", "classification": ["privileged", "exposure"],
     "text": "The former employee's confidentiality obligation (clause 12) survives termination; counsel's letter demands deletion and certification within 5 business days and reserves an injunction.",
     "deliver": ["commander", "legal"], "deny": ["oncall-engineer", "comms", "support"],
     "check": {"any_of": ["clause 12", "injunction", "certification within 5"]}},
    {"id": "X03-F17", "document": "04-legal-memo", "classification": ["privileged", "exposure"],
     "text": "Do not contact the former employee directly and do not accuse them to customers.",
     "deliver": ["commander", "legal"], "deny": ["oncall-engineer", "comms", "support"],
     "check": {"any_of": ["contact the former employee directly", "accuse"]}},
    {"id": "X03-F18", "document": "04-legal-memo", "classification": ["privileged", "exposure"],
     "text": "Externally: do not name or describe the former employee, and do not state the number of records or the file name.",
     "deliver": ["commander", "legal"], "deny": ["oncall-engineer", "support"],
     "check": {"any_of": ["do not name or describe", "do not state the number of records"]},
     "note": "the customer notice draft (public) says what was not given; the instruction wording ('do not ...') is the privileged part."},

    {"id": "X03-F19", "document": "05-customer-impact", "classification": ["customer-impact", "public"],
     "text": "Staff at 212 customer clinics are affected: names, work emails and work phones; no patient information or passwords.",
     "deliver": ["commander", "security-lead", "oncall-engineer", "legal", "comms", "support"], "deny": [],
     "check": {"any_of": ["212"]}},
    {"id": "X03-F20", "document": "05-customer-impact", "classification": ["customer-impact", "public"],
     "text": "There was no outage and no change to any account.",
     "deliver": ["commander", "comms", "support"], "deny": [],
     "check": {"any_of": ["no outage", "not affected", "nothing visible"]}},
    {"id": "X03-F21", "document": "05-customer-impact", "classification": ["customer-impact", "public"],
     "text": "Customers may receive unsolicited emails or calls; any such contact is unofficial and should be reported to support.",
     "deliver": ["commander", "legal", "comms", "support"], "deny": [],
     "check": {"any_of": ["unsolicited", "unofficial"]}},
    {"id": "X03-F22", "document": "05-customer-impact", "classification": ["customer-impact", "public"],
     "text": "XYZ never asks for passwords or payment details by email or phone.",
     "deliver": ["commander", "support"], "deny": [],
     "check": {"any_of": ["never asks", "payment details"]}},
    {"id": "X03-F23", "document": "05-customer-impact", "classification": ["customer-impact", "public"],
     "text": "Customers can request confirmation of which staff were included; support replies within two business days.",
     "deliver": ["commander", "support"], "deny": [],
     "check": {"any_of": ["two business days", "which of their staff", "confirmation"]}},

    {"id": "X03-F24", "document": "06-status-page-draft", "classification": ["public", "timeline"],
     "text": "The customer notice says a former employee's access was reviewed and a list of business contact details was exported without authorisation; it goes to all customers on Monday.",
     "deliver": ["commander", "comms", "support"], "deny": [],
     "check": {"any_of": ["former employee's access", "without authorisation", "without authorization"]}},
    {"id": "X03-F25", "document": "06-status-page-draft", "classification": ["public", "timeline"],
     "text": "The notice does not name the former employee and does not give the number of records or the file name.",
     "deliver": ["commander", "comms"], "deny": [],
     "check": {"any_of": ["not named", "have not named", "number of records"]}},

    {"id": "X03-F26", "document": "07-exec-brief", "classification": ["exposure", "timeline", "remediation"],
     "text": "Cost so far: about 22 engineering hours, outside counsel, and an estimated 30 support hours.",
     "deliver": ["commander"], "deny": ["comms", "support"],
     "check": {"any_of": ["22 engineering hours", "30 support hours"]}},
    {"id": "X03-F27", "document": "07-exec-brief", "classification": ["exposure", "timeline", "remediation"],
     "text": "Decision: no regulator notification, on legal's assessment, with the decision documented.",
     "deliver": ["commander", "legal", "security-lead"], "deny": ["comms", "support"],
     "check": {"any_of": ["no regulator notification", "regulator notification"]}}
  ],
  "forbidden_patterns": {
    "internal_hostname": "\\b(?:admin-web|dlp|ws)-\\d{2,4}\\b",
    "employee_id": "\\bE-\\d{4}\\b",
    "dlp_rule": "\\bDLP-\\d+\\b",
    "ticket_id": "\\bXYZ-\\d{3,5}\\b",
    "file_name": "customers_contacts_export|\\.csv\\b",
    "contract_clause": "\\bclause \\d+(?:\\.\\d+)?\\b",
    "statute": "§\\s?\\d+|\\b\\d+ CFR \\d+",
    "named_customer": "Harbor Clinic|Westfield Family|Lakeside Paediatrics"
  },
  "pattern_free_roles": ["comms", "support"]
}
